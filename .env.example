# Chatbot provider. Pick ONE of these (free options first). Leave all empty for offline mode.
# Option 1 (free, cloud): get a key at https://aistudio.google.com  -> API key

# Option 2 (free tier, cloud): key from https://console.groq.com

# Option 3 (free, fully local): install Ollama from https://ollama.com, then run:  ollama pull llama3.2
#   no key needed; Hydra detects it automatically when Ollama is running.

# HYDRA_CAMERA=0
# PORT=8000
GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# HYDRA_PROVIDER=groq
# HYDRA_MODEL=llama-3.1-8b-instant
# HYDRA_PROVIDER=groq
# HYDRA_MODEL=llama-3.1-8b-instant