{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Hydra.ai (debug server)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["hydra.main:app", "--host", "127.0.0.1", "--port", "8000"],
      "env": { "PYTHONPATH": "${workspaceFolder}" },
      "console": "integratedTerminal"
    },
    {
      "name": "Hydra.ai tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-v"],
      "console": "integratedTerminal"
    }
  ]
}
